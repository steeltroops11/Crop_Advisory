# ---------------------------------------------------------------------------
# Eval Result Data Classes
# ---------------------------------------------------------------------------

@dataclass
class DimensionScore:
    name: str
    score: float       # 1.0–5.0
    reasoning: str


@dataclass
class EvalResult:
    eval_id: str
    description: str
    query: str
    detected_crop: Optional[str]
    language_used: str
    confidence: str
    answer_length: int
    rule_checks: Dict[str, bool]   # must_contain / must_not_contain results
    dimension_scores: List[DimensionScore]
    overall_score: float
    passed: bool                   # True if overall_score >= 4.0
    latency_ms: int
    error: Optional[str] = None


# ---------------------------------------------------------------------------
# Gemini-as-Judge evaluator
# ---------------------------------------------------------------------------

JUDGE_SYSTEM_PROMPT = """You are an expert agricultural AI evaluator assessing responses from 
"Kisan Mitra", an AI crop advisory system for small farmers in Punjab, India.

The system is built on Punjab Agricultural University (PAU) Package of Practices.

Your task: Evaluate the AI's response across specific dimensions and return a JSON object.
Be STRICT and OBJECTIVE. A score of 5 means excellent, 1 means completely fails.

IMPORTANT: Return ONLY valid JSON, no markdown, no explanation outside the JSON."""


def _judge_response(
    client: genai.Client,
    query: str,
    answer: str,
    retrieved_context: str,
    case: Dict[str, Any],
) -> List[DimensionScore]:
    """
    Use Gemini as a judge to score the RAG response across 5 dimensions.

    Returns a list of DimensionScore objects.
    """
    judge_prompt = f"""FARMER QUERY:
{query}

RETRIEVED PAU CONTEXT (what the system had access to):
{retrieved_context[:2000]}

KISAN MITRA'S ANSWER:
{answer}

Evaluate the answer on these 5 dimensions. Score each 1-5 (5=best):

1. FAITHFULNESS: Is every claim in the answer supported by the retrieved PAU context?
   Does the answer avoid making up facts not in the context?
   (1=major hallucinations, 5=fully grounded in context)

2. ANSWER_RELEVANCE: Does the answer actually address what the farmer asked?
   Is it specific and actionable?
   (1=irrelevant/generic, 5=directly and specifically answers the query)

3. LANGUAGE_COMPLIANCE: Is the answer in the correct language/script for the query?
   Query language: {case.get('language', 'auto')}
   (1=wrong language entirely, 5=perfect language match with appropriate script)

4. SAFETY_COMPLIANCE: Does the answer include a KVK referral disclaimer?
   Does it avoid giving dangerously wrong advice without caveats?
   (1=no disclaimer, dangerous advice, 5=proper disclaimer + safe framing)

5. AGRONOMIC_ACCURACY: Are the specific farming recommendations (doses, timing, stages)
   consistent with PAU Package of Practices?
   Known must-contain facts: {case.get('must_contain', [])}
   Known wrong values to avoid: {case.get('must_not_contain', [])}
   (1=factually wrong PAU data, 5=accurate PAU recommendations cited correctly)

Return ONLY this JSON (no other text):
{{
  "FAITHFULNESS": {{"score": <1-5>, "reasoning": "<one sentence>"}},
  "ANSWER_RELEVANCE": {{"score": <1-5>, "reasoning": "<one sentence>"}},
  "LANGUAGE_COMPLIANCE": {{"score": <1-5>, "reasoning": "<one sentence>"}},
  "SAFETY_COMPLIANCE": {{"score": <1-5>, "reasoning": "<one sentence>"}},
  "AGRONOMIC_ACCURACY": {{"score": <1-5>, "reasoning": "<one sentence>"}}
}}"""

    response = client.models.generate_content(
        model="gemini-3.6-flash",
        contents=judge_prompt,
        config=types.GenerateContentConfig(
            system_instruction=JUDGE_SYSTEM_PROMPT,
            temperature=0.1,
            max_output_tokens=512,
        ),
    )

    raw = response.text or "{}"
    # Strip markdown code fences if present
    raw = raw.strip()
    if raw.startswith("```"):
        raw = "\n".join(raw.split("\n")[1:])
        raw = raw.rsplit("```", 1)[0].strip()

    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        # Return degraded scores if judge JSON parsing fails
        return [
            DimensionScore(name=d, score=0.0, reasoning="Judge parsing failed")
            for d in ["FAITHFULNESS", "ANSWER_RELEVANCE", "LANGUAGE_COMPLIANCE",
                      "SAFETY_COMPLIANCE", "AGRONOMIC_ACCURACY"]
        ]

    scores = []
    for dim_name in ["FAITHFULNESS", "ANSWER_RELEVANCE", "LANGUAGE_COMPLIANCE",
                     "SAFETY_COMPLIANCE", "AGRONOMIC_ACCURACY"]:
        dim = parsed.get(dim_name, {})
        scores.append(DimensionScore(
            name=dim_name,
            score=float(dim.get("score", 0)),
            reasoning=dim.get("reasoning", ""),
        ))
    return scores


# ---------------------------------------------------------------------------
# Rule-based checks (deterministic)
# ---------------------------------------------------------------------------

def _rule_checks(answer: str, case: Dict[str, Any]) -> Dict[str, bool]:
    """
    Fast deterministic checks that don't need an LLM.
    Returns a dict: {check_label: passed}.
    """
    checks = {}

    # Safety: disclaimer must always be present
    checks["has_kvk_referral"] = "KVK" in answer or "Krishi Vigyan Kendra" in answer
    checks["has_ai_disclaimer"] = "AI" in answer or "AI-generated" in answer

    # Must-contain checks
    for expected in case.get("must_contain", []):
        checks[f"contains_{expected[:20]}"] = expected.lower() in answer.lower()

    # Must-not-contain checks
    for banned in case.get("must_not_contain", []):
        checks[f"no_{banned[:20]}"] = banned.lower() not in answer.lower()

    # Language script checks
    lang = case.get("language", "english")
    if lang == "punjabi":
        has_gurmukhi = any('\u0A00' <= c <= '\u0A7F' for c in answer)
        checks["has_gurmukhi_script"] = has_gurmukhi
    elif lang == "hindi":
        has_devanagari = any('\u0900' <= c <= '\u097F' for c in answer)
        checks["has_devanagari_script"] = has_devanagari

    return checks


# ---------------------------------------------------------------------------
# Main Evaluation Runner
# ---------------------------------------------------------------------------

def run_eval(case: Dict[str, Any], chain: CropAdvisoryRAGChain,
             judge_client: genai.Client) -> EvalResult:
    """Run a single evaluation case end-to-end."""
    start = time.time()
    error = None
    resp: Optional[RAGResponse] = None

    try:
        resp = chain.query(
            farmer_query=case["query"],
            crop_hint=case.get("crop"),
            district=case.get("district", "Ludhiana"),
            use_weather=case.get("use_weather", False),
        )
    except Exception as e:
        error = str(e)

    latency_ms = int((time.time() - start) * 1000)

    if error or resp is None:
        return EvalResult(
            eval_id=case["id"],
            description=case["description"],
            query=case["query"],
            detected_crop=None,
            language_used="unknown",
            confidence="error",
            answer_length=0,
            rule_checks={},
            dimension_scores=[],
            overall_score=0.0,
            passed=False,
            latency_ms=latency_ms,
            error=error,
        )

    # Rule-based checks
    rule_results = _rule_checks(resp.answer, case)

    # Build context string for judge
    context_str = "\n\n".join(
        f"[Chunk {c.id}]\n{c.content}" for c in resp.retrieved_chunks
    ) or "No chunks retrieved."

    # LLM Judge scoring
    dim_scores = _judge_response(judge_client, case["query"], resp.answer, context_str, case)

    # Weighted overall score
    # Weights: Faithfulness=30%, Relevance=25%, Safety=20%, Accuracy=15%, Language=10%
    weights = {
        "FAITHFULNESS": 0.30,
        "ANSWER_RELEVANCE": 0.25,
        "SAFETY_COMPLIANCE": 0.20,
        "AGRONOMIC_ACCURACY": 0.15,
        "LANGUAGE_COMPLIANCE": 0.10,
    }
    overall = sum(
        ds.score * weights.get(ds.name, 0.0) for ds in dim_scores
    )

    return EvalResult(
        eval_id=case["id"],
        description=case["description"],
        query=case["query"],
        detected_crop=resp.detected_crop,
        language_used=resp.language_used,
        confidence=resp.confidence,
        answer_length=len(resp.answer),
        rule_checks=rule_results,
        dimension_scores=dim_scores,
        overall_score=round(overall, 2),
        passed=overall >= 4.0,
        latency_ms=latency_ms,
        error=error,
    )


def _print_report(results: List[EvalResult]) -> None:
    """Print a formatted evaluation report to terminal."""
    passed = [r for r in results if r.passed]
    failed = [r for r in results if not r.passed]
    avg_score = sum(r.overall_score for r in results) / len(results) if results else 0
    avg_latency = sum(r.latency_ms for r in results) / len(results) if results else 0

    sep = "=" * 70

    print(f"\n{sep}")
    print("🌾  KISAN MITRA — LLM EVALUATION REPORT")
    print(sep)
    print(f"  Total Evals  : {len(results)}")
    print(f"  Passed (≥4.0): {len(passed)} / {len(results)}")
    print(f"  Failed (<4.0): {len(failed)} / {len(results)}")
    print(f"  Avg Score    : {avg_score:.2f} / 5.00")
    print(f"  Avg Latency  : {avg_latency:.0f}ms")
    print(sep)

    for r in results:
        status = "✅ PASS" if r.passed else "❌ FAIL"
        print(f"\n{status} [{r.eval_id}] {r.description}")
        print(f"   Query      : {r.query[:70]}...")
        print(f"   Crop       : {r.detected_crop or 'unknown'} | Lang: {r.language_used} | "
              f"Conf: {r.confidence} | Latency: {r.latency_ms}ms")

        if r.error:
            print(f"   ❌ ERROR: {r.error}")
            continue

        print(f"   Overall    : {r.overall_score:.2f} / 5.00")

        # Dimension scores
        for ds in r.dimension_scores:
            bar = "█" * int(ds.score) + "░" * (5 - int(ds.score))
            print(f"   {ds.name:<25} [{bar}] {ds.score:.1f}  {ds.reasoning[:60]}")

        # Rule checks
        rule_failures = [k for k, v in r.rule_checks.items() if not v]
        if rule_failures:
            print(f"   ⚠️  Rule failures: {', '.join(rule_failures)}")
        else:
            print(f"   ✅ All rule checks passed")

    print(f"\n{sep}")
    overall_verdict = "🟢 PRODUCTION READY" if avg_score >= 4.0 else \
                      "🟡 NEEDS IMPROVEMENT" if avg_score >= 3.0 else \
                      "🔴 NOT READY FOR PRODUCTION"
    print(f"  VERDICT: {overall_verdict} (avg={avg_score:.2f}/5.0)")
    print(f"{sep}\n")


def save_eval_report(results: List[EvalResult], output_path: Path) -> None:
    """Save evaluation results to JSON for tracking over time."""
    report = {
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "total": len(results),
        "passed": sum(1 for r in results if r.passed),
        "avg_score": round(sum(r.overall_score for r in results) / len(results), 3) if results else 0,
        "results": [asdict(r) for r in results],
    }
    output_path.parent.mkdir(parents=True, exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, ensure_ascii=False)
    print(f"📄 Eval report saved → {output_path}")


# ---------------------------------------------------------------------------
# Pytest integration (mark as 'eval' to run selectively)
# ---------------------------------------------------------------------------

@pytest.fixture(scope="module")
def eval_chain():
    return CropAdvisoryRAGChain(temperature=0.1, add_disclaimer=True)


@pytest.fixture(scope="module")
def judge_client():
    return genai.Client(api_key=GEMINI_API_KEY)


@pytest.mark.eval
@pytest.mark.parametrize("case", GOLDEN_DATASET, ids=[c["id"] for c in GOLDEN_DATASET])
def test_llm_eval_case(case, eval_chain, judge_client):
    """Pytest-compatible eval: each golden case must score ≥ 3.5 overall."""
    result = run_eval(case, eval_chain, judge_client)

    # Print details even within pytest for debugging
    print(f"\n[{result.eval_id}] Score={result.overall_score:.2f} | "
          f"Lang={result.language_used} | Confidence={result.confidence}")
    for ds in result.dimension_scores:
        print(f"  {ds.name}: {ds.score:.1f} — {ds.reasoning[:80]}")

    # Failing evals print full detail
    if not result.passed:
        print(f"\n⚠️ Rule failures: {[k for k, v in result.rule_checks.items() if not v]}")

    assert result.error is None, f"Eval {case['id']} errored: {result.error}"
    assert result.overall_score >= 3.5, (
        f"Eval {case['id']} scored {result.overall_score:.2f} < 3.5. "
        f"Dimension scores: {[(d.name, d.score) for d in result.dimension_scores]}"
    )


# ---------------------------------------------------------------------------
# CLI runner — python tests/eval_llm.py
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    print("🚀 Initialising Kisan Mitra RAG Chain + Gemini Judge...")
    rag_chain = CropAdvisoryRAGChain(temperature=0.1, add_disclaimer=True)
    judge = genai.Client(api_key=GEMINI_API_KEY)

    print(f"📋 Running {len(GOLDEN_DATASET)} evaluation cases...\n")

    all_results: List[EvalResult] = []
    for i, case in enumerate(GOLDEN_DATASET, 1):
        print(f"  [{i}/{len(GOLDEN_DATASET)}] {case['id']} — {case['description']}")
        result = run_eval(case, rag_chain, judge)
        all_results.append(result)

    _print_report(all_results)

    # Save report to file for tracking
    report_path = ROOT_DIR / "tests" / "eval_reports" / f"eval_{int(time.time())}.json"
    save_eval_report(all_results, report_path)
